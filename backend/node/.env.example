# Auto Trading Backend Configuration
# Copy this to .env and fill your credentials

# Server
PORT=3001
NODE_ENV=development

# Trading Mode: PAPER or LIVE
# PAPER = No real money, simulated orders
# LIVE = Real orders on your broker account
MODE=PAPER

# Broker: MOCK, DHAN, GROWW, ZERODHA, ANGEL
BROKER=MOCK

# Capital & Risk
CAPITAL=100000
RISK_PER_TRADE=1
MAX_DAILY_LOSS=2
MAX_POSITIONS=3

# ===== DHAN (Recommended - Free Official API) =====
# Get from https://dhan.co -> My Profile -> DhanHQ Trading APIs
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ===== GROWW (No official API - Uses browser automation) =====
# Method: PLAYWRIGHT (automates website) or API (uses token)
GROWW_METHOD=PLAYWRIGHT
# For API method, get token from DevTools -> Application -> Local Storage -> groww.in -> groww_jwt
GROWW_TOKEN=
# Session file for Playwright (auto-created after first login)
GROWW_SESSION_FILE=./groww-session.json
# Show browser? false = you see browser for OTP, true = headless
GROWW_HEADLESS=false

# ===== ZERODHA (Paid API) =====
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# ===== ANGEL ONE (Free) =====
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_API_KEY=

# ===== Strategy =====
STRATEGIES=COMBINED
# Options: RSI_REVERSAL, EMA_CROSSOVER, BREAKOUT, SUPERTREND, VWAP_RSI, COMBINED

# Symbols to trade (comma separated)
SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,BHARTIARTL,ITC,LT,MARUTI

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
